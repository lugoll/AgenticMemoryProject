# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Data layer
# Rohdaten und abgeleitete Daten nicht ins Git
data/hotpotqa.json
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/baseline_dummy*
!data/raw/multihop_benchmark*
!data/processed/.gitkeep
!data/processed/baseline_dummy*

# Stores: BM25 und Graph werden committet, damit kein Ingest nötig ist.
# Vector (ChromaDB) läuft als Docker Volume und ist nicht committbar —
# muss lokal per `uv run python scripts/02_setup.py --variant vector` aufgebaut werden.
data/stores/*
!data/stores/.gitkeep
!data/stores/bm25.db
!data/stores/graph.json
!data/stores/graph.checkpoint

# Evaluation outputs — generated artifacts, not source
evaluations/*
!evaluations/.gitkeep

# Jupyter
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints/

# Environment & secrets
.env
.env.*
*.secret

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# LlamaIndex / ChromaDB / vector store artifacts
chroma_db/
*.index
*.faiss
*.pkl

# Neo4j local data
neo4j/data/

